# =============================================================================
# pkg-config package template for librazobill
#
# provides compiler and linker flags for external C and C++ consumers
# ~ ملف توصيف الحزمة لبرامج لينكس عشان يلاقوا المكتبة ورؤوس الترويسات
# =============================================================================

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: librazobill
Description: High-performance C++20 log parsing and semantic accounting engine
Version: @LIBRAZOBILL_PROJECT_VERSION@
Libs: -L${libdir} -lrazobill_cabi
Libs.private: -L${libdir} -lrazobill_static
Cflags: -I${includedir}
