# Razobill parser fuzzer dictionary
# Control characters and escape sequences
"\x11"
"\x12"
"\x13"
"\x11\x11"
"\x11\x12"
"\x11\x13"

# Slot and template tokens
"{i}"
"{s}"
"<*>"
"{{}}"
"{raw}"

# Delimiters and punctuation
" "
"\t"
"\r\n"
"\n"
"="
":"
";"
"|"
","
"/"
"\""
"'"
"["
"]"
"("
")"

# Common log prefixes and keywords
"Failed password for"
"Accepted publickey for"
"Receiving block blk_"
"src:"
"dest:"
"pam_unix"
"sshd:session"
"authentication failure"
"user="
"port"
"ssh2"
"HTTP/1.1"
"GET"
"POST"
"200"
"404"
"500"
"INFO"
"WARN"
"ERROR"
"FATAL"
"DEBUG"

# Extreme numerical boundary values
"0"
"-1"
"1"
"9223372036854775807"
"-9223372036854775808"
"18446744073709551615"
"2147483647"
"-2147483648"
"4294967295"
"1.0"
"1e5"
"0.000001"
