<button class="search-btn" type="button" data-search-open aria-haspopup="dialog">
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.75" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 10l4.5 4.5" stroke="currentColor" stroke-width="1.5"/></svg>
  <span class="search-label">Search the docs</span>
  <kbd class="search-kbd" aria-hidden="true">Ctrl K</kbd>
</button>

<dialog class="search" aria-label="Search the docs">
  <form method="dialog" class="search-form">
    <input class="search-input" type="search" name="q" placeholder="Search the docs" autocomplete="off" spellcheck="false"
           role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
    <button class="search-close" value="close" aria-label="Close search">Esc</button>
  </form>
  <ul class="search-results" id="search-results" role="listbox" aria-label="Results"></ul>
  <p class="search-msg" role="status" aria-live="polite">Type to search all documentation pages.</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.search')!;
  const input = dialog.querySelector<HTMLInputElement>('.search-input')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;
  const msg = dialog.querySelector<HTMLParagraphElement>('.search-msg')!;
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
  document.querySelectorAll<HTMLElement>('.search-kbd').forEach((k) => (k.textContent = isMac ? '⌘K' : 'Ctrl K'));

  let pf: any, loading: Promise<any> | undefined, active = -1, timer: number;
  const load = () => (loading ??= import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`).then((m) => { pf = m; m.options?.({ baseUrl: `${base}/` }); return m.init?.(), m; }).catch(() => null));

  const open = () => { if (!dialog.open) dialog.showModal(); input.focus(); input.select(); load(); };
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dialog.open ? dialog.close() : open(); }
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { input.value = ''; list.replaceChildren(); input.setAttribute('aria-expanded', 'false'); msg.textContent = 'Type to search all documentation pages.'; });

  const setActive = (n: number) => {
    const items = [...list.children] as HTMLElement[];
    if (!items.length) return;
    active = (n + items.length) % items.length;
    items.forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  };
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') { const a = list.children[active]?.querySelector('a'); if (a) { e.preventDefault(); location.href = a.href; } }
  });

  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(async () => {
      const q = input.value.trim();
      list.replaceChildren(); active = -1; input.setAttribute('aria-expanded', 'false');
      if (!q) { msg.textContent = 'Type to search all documentation pages.'; return; }
      const mod = await load();
      if (!mod) { msg.textContent = 'The search index is created by "npm run build". It is not available in dev mode.'; return; }
      const res = await mod.search(q);
      const hits = await Promise.all(res.results.slice(0, 8).map((r: any) => r.data()));
      if (!hits.length) { msg.textContent = `No pages match “${q}”.`; return; }
      msg.textContent = `${res.results.length} ${res.results.length === 1 ? 'page matches' : 'pages match'}.`;
      for (const h of hits) {
        const li = document.createElement('li'); li.setAttribute('role', 'option'); li.setAttribute('aria-selected', 'false');
        const a = document.createElement('a'); a.href = h.url;
        const t = document.createElement('strong'); t.textContent = h.meta?.title ?? h.url;
        const p = document.createElement('span'); p.className = 'search-excerpt'; p.innerHTML = h.excerpt; // Pagefind escapes content; only <mark> is emitted
        a.append(t, p); li.append(a); list.append(li);
      }
      input.setAttribute('aria-expanded', 'true'); setActive(0);
    }, 120);
  });
</script>
